.DS_Store
nes_power_video-backups/

# KiCad transient files
_autosave-*
*.lck
~*.lck
*-backups/

# KiCad Local History (File > Local History) - its own nested git repo,
# committed as a gitlink by mistake. Keep the folder, don't track it.
.history/

# Stray empty stub sheets from a "new sheet" saved with a blank filename
.kicad_sch
.kicad_sch.kicad_sch

# kicad-happy analyzer output — timestamped run folders, expensive to
# regenerate but not worth versioning. Regenerate with the kicad skill.
analysis/

# Vendor datasheet PDFs pulled by the distributor skills. Large binaries,
# freely re-downloadable from TI/LCSC/DigiKey.
datasheets/

# Python bytecode caches — running the prefab-gate unit suite creates these.
__pycache__/
*.pyc

# ---------------------------------------------------------------------------
# Generated output. The KiCad project is the source; everything below is
# derived from it and reproducible, so it does not belong in the working tree.
# The packages that were actually fabbed remain in git history — see the
# 2026-07-07 and 2026-07-16 commits — they are just no longer checked out.
# ---------------------------------------------------------------------------

# Fab packages. Regenerate with:
#   python3 prefab-gate/scripts/prefab_gate.py package nes_power_video.kicad_pcb --out pcbway_production
#   python3 tools/pcbway_assembly.py nes_power_video.kicad_pcb pcbway_production/<timestamp>
pcbway_production/

# KiCad-Diff output — per-commit board checkouts, layer SVGs and the web
# gallery. Written into the repo by `kidiff`, regenerated on every run.
.kidiff/

# Gerbers, drill files and board reports, wherever they are written.
*.gbr
*.gbrjob
*.drl
*_statistics.rpt
*.kicad_pcb.zip

# Schematic/PCB PDF plots and hand-pulled vendor datasheets. The schematic
# itself is the source; these are prints of it.
nes_power_video.pdf
NES-CPU-04.pdf

# KiCad per-user project state — open tabs, zoom, last-used paths. Local to
# whoever opened the project, and noise in every diff.
*.kicad_prl

# Local shell env. Holds no secrets itself; it sources ~/.config/secrets.env,
# where the DigiKey and Mouser API keys actually live.
.zshenv

# Scratch notes from review sessions, not project documentation.
gateissues.txt
prefab_gate_review.md

# Stray npm lockfile — nothing in this repo is a node package.
package-lock.json
