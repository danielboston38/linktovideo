			(uuid "bc460fd5-cc0c-448c-bf68-90843612c33c")
			(effects
				(font
					(size 1.27 1.27)
					(thickness 0.15)
				)
			)
		)
		(property "Footprint Note" "Exact KiCad footprint for this MPN. USB_C_Receptacle_GCT_USB4125-xx-x-0190 is byte-identical in copper, silk, fab, courtyard and drills to the plain USB4125-xx-x land pattern the board was laid out with - only the name, descr and 3D model differ - so this is a naming correction, not a layout change. The -0190 suffix is the 1.90 mm shell stake, which protrudes 0.30 mm through a 1.6 mm board and gives a bottom-side fillet; the 1.00 mm stake (plain USB4125-GF-A, LCSC C3151650) does not reach through."
			(at 0 0 0)
			(layer "F.Fab")
			(hide yes)
			(uuid "e8b68e06-314c-4a7d-80e1-8b70e57ebea8")
			(effects
				(font
					(size 1.27 1.27)
					(thickness 0.15)
				)
			)
		)
