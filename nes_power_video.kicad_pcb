		(property "Spec" "USB Type-C receptacle, 6P power-only (VBUS x2, GND x2, CC1, CC2), 48 V / 3 A, 20,000 mating cycles, 1.90 mm shell stake"
			(at 0 0 0)
			(layer "F.Fab")
